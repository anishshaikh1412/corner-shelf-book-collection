<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Book</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <style>
        body {
            background: #f4f1eb;
            color: #29251f;
            font-family: Arial, sans-serif;
        }

        .topbar {
            background: #2f3e36;
            color: white;
            padding: 16px 0;
        }

        .site-name {
            font-size: 21px;
            font-weight: 600;
        }

        .edit-area {
            width: 92%;
            max-width: 700px;
            margin: 45px auto;
        }

        .edit-box {
            background: white;
            border: 1px solid #ded9d0;
            border-radius: 8px;
            padding: 32px;
        }

        .page-title {
            font-weight: 600;
            margin-bottom: 5px;
        }

        .sub-title {
            color: #777168;
            margin-bottom: 28px;
        }

        .form-label {
            font-size: 14px;
            font-weight: 600;
            margin-bottom: 7px;
        }

        .form-control {
            border: 1px solid #cfc9bf;
            border-radius: 5px;
            padding: 11px 12px;
        }

        .update-btn {
            background: #2f3e36;
            border: none;
            padding: 10px 20px;
        }

        .update-btn:hover {
            background: #24312b;
        }

        .back-link {
            color: #555;
            text-decoration: none;
            margin-left: 12px;
        }
    </style>
</head>

<body>

    <div class="topbar">
        <div class="container">
            <div class="site-name">Corner Shelf</div>
        </div>
    </div>

    <div class="edit-area">
        <div class="edit-box">

            <h2 class="page-title">Edit Book</h2>

            <p class="sub-title">
                Update the information for this book.
            </p>

            <form action="/edit/<%= product._id %>" method="POST">

                <div class="mb-3">
                    <label class="form-label">Book Name</label>

                    <input
                        type="text"
                        name="name"
                        value="<%= product.name %>"
                        class="form-control"
                        required
                    >
                </div>

                <div class="mb-3">
                    <label class="form-label">Price</label>

                    <input
                        type="number"
                        name="price"
                        value="<%= product.price %>"
                        class="form-control"
                        min="0"
                        required
                    >
                </div>

                <div class="mb-4">
                    <label class="form-label">Genre</label>

                    <input
                        type="text"
                        name="category"
                        value="<%= product.category %>"
                        class="form-control"
                        required
                    >
                </div>

                <button type="submit" class="btn btn-primary update-btn">
                    Update Book
                </button>

                <a href="/" class="back-link">
                    Back to collection
                </a>

            </form>

        </div>
    </div>

</body>
</html>
